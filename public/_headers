# Sprite sheets and town data are stable art files served straight from Workers assets.
# Not immutable and not a year: these paths are not content-hashed, so an edit has to be
# able to reach someone who already holds a copy. A month with a week of
# stale-while-revalidate gets the repeat-visit win without that trap.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# The town layout changes more often than the art does.
/example-states/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
